# Copy to .env and edit. Never commit .env.

# Guards POST /api/killswitch. Empty disables the endpoint. Generate with: openssl rand -hex 24
FIXGW_ADMIN_TOKEN=

# Public deployment only (--profile public): the DNS name that points at this machine.
DOMAIN=

# Credentials file for the FIX counterparties. The default is the public demo file;
# for anything reachable from the internet run scripts/gen-credentials.sh and set
# CREDS_FILE=./deploy/credentials.json
CREDS_FILE=./deploy/credentials.example.json

# Address the FIX port (5001) is published on. 127.0.0.1 keeps it private; use
# 0.0.0.0 only with generated credentials.
FIX_BIND=127.0.0.1
